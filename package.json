{
  "name": "liquidity-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm build && node scripts/dev.mjs",
    "test": "pnpm build && tsc -p tsconfig.tests.json && node --test tests/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "check": "pnpm test && node scripts/check-boundaries.mjs",
    "replay": "node scripts/replay.ts",
    "slingshot": "node scripts/slingshot.ts",
    "start": "node --env-file-if-exists=apps/server/.env.local scripts/start.mjs"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.4",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
